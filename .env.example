# ==============================================================================
# HireHQ - environment configuration
#
# Copy to `.env` and adjust. Never commit `.env`.
#
# The defaults below run the whole product with **zero external infrastructure**:
# SQLite, local file storage, the built-in deterministic AI engine and an email
# transport that records messages without transmitting them. Every one of those is
# reported honestly by the API (`GET /health`, `GET /api/v1/ai/status`,
# `GET /api/v1/emails/provider-status`) so nothing is ever presented as working when
# it is not.
#
# For production, set APP_ENV=production - startup then refuses weak secrets,
# DEBUG=true, and local file storage.
# ==============================================================================

# ------------------------------------------------------------------ application
APP_NAME=HireHQ
APP_ENV=development                       # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
LOG_JSON=false                            # true in production for structured log shipping

# --------------------------------------------------------------------- database
# SQLite (default) needs nothing installed. Swap in PostgreSQL for anything real.
DATABASE_URL=sqlite+aiosqlite:///./hirehq.db
# DATABASE_URL=postgresql+asyncpg://hirehq:hirehq@localhost:5432/hirehq
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------ redis
REDIS_URL=redis://localhost:6379/0
# false -> background jobs run in-process (fine for dev, not durable).
# true  -> jobs go to Redis and are processed by the ARQ worker.
USE_REDIS_QUEUE=false
USE_REDIS_CACHE=false

# -------------------------------------------------------------------------- jwt
# MUST be changed for production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
JWT_REFRESH_ROTATION=true

PASSWORD_MIN_LENGTH=10
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------- storage
# local -> filesystem, development only (still enforces signed URLs).
# s3    -> any S3-compatible endpoint: AWS S3, MinIO, Cloudflare R2, Spaces.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hirehq
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=900
# Sent as x-amz-server-side-encryption on upload. AWS S3 and MinIO accept AES256.
# Cloudflare R2 encrypts every object automatically and REJECTS this header — leave it
# empty for R2. Objects are encrypted at rest either way.
STORAGE_SERVER_SIDE_ENCRYPTION=AES256

MAX_RESUME_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
ALLOWED_RESUME_EXTENSIONS=pdf,docx

# --------------------------------------------------------------------------- ai
# heuristic -> deterministic built-in engine. No credentials, no network. Real
#              parsing, extraction and scoring; not a language model, and never
#              presented as one.
# anthropic -> Claude. Requires AI_API_KEY.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_ASSISTANT_MODEL=claude-opus-5
AI_MAX_TOKENS=8000
AI_EFFORT=medium                          # low | medium | high | xhigh | max
AI_TIMEOUT_SECONDS=120
EMBEDDING_PROVIDER=lexical

# ------------------------------------------------------------------------ email
# smtp    -> real delivery.
# console -> records the message and reports NOT_SENT_NO_PROVIDER. Never claims
#            an email was delivered when it was not.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@hirehq.test
EMAIL_FROM_NAME=HireHQ

# --------------------------------------------------------------------- calendar
# none -> interviews live in HireHQ only; no external invitations are sent, and
#         the API says so (sync_status=PENDING_NO_PROVIDER).
CALENDAR_PROVIDER=none
#
# The same Google/Microsoft app credentials are used for calendar sync and for the
# email inbox (see "mailbox sync" below). Register BOTH redirect URIs listed here with
# the provider - the two flows land on different callbacks, and the signed `state`
# parameter is scoped to one purpose so a calendar consent cannot complete a mailbox
# connection (or vice versa).
#
#   http://localhost:8000/api/v1/calendar/callback
#   http://localhost:8000/api/v1/emails/accounts/callback
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback

# ----------------------------------------------------------------- mailbox sync
# Pulling candidate replies into the HireHQ inbox reuses the Google/Microsoft
# credentials above - there is no separate MAILBOX_PROVIDER switch. A recruiter
# connects their own mailbox from Settings -> Email; nothing is read until they do.
#
# Scopes requested are READ-ONLY (gmail.readonly / Mail.Read): HireHQ imports replies
# and never sends from, deletes from, or otherwise modifies a personal mailbox.
# Outbound mail always goes through the SMTP settings above.
#
# The `sync_mailboxes` cron job polls every 5 minutes when the ARQ worker is running;
# without the worker, use POST /api/v1/emails/accounts/{id}/sync to pull on demand.
# OAuth tokens are stored AES-256-GCM encrypted, keyed from JWT_SECRET - rotating
# JWT_SECRET therefore invalidates stored tokens and requires reconnecting.

# ---------------------------------------------------------------- sms / whatsapp
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------- code execution
# How coding and SQL assessment answers are graded.
#
# manual -> nothing is executed. Submissions are stored and the attempt reports them
#           as awaiting human review. Never invents a pass/fail.
# sqlite -> additionally grades SQL answers against a disposable in-memory database
#           (safe in-process: no filesystem, network, or extension access, and a
#           step budget aborts a runaway query). Coding answers still go to a human.
# remote -> delegates to a Judge0-compatible sandbox YOU operate. HireHQ never runs
#           untrusted candidate code inside its own process or network.
#
# A runner that cannot execute a submission reports "not graded", never "failed".
CODE_RUNNER=sqlite
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
CODE_RUNNER_TIMEOUT_SECONDS=10

# ------------------------------------------------------------ malware scanning
# basic  -> structural checks only (magic bytes, embedded JS/macros, zip bombs).
#           Reports NOT_SCANNED rather than claiming a file is clean.
# clamav -> real ClamAV daemon.
MALWARE_SCANNER=basic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --------------------------------------------------------------------- security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_PER_MINUTE=120

# ----------------------------------------------- ATS defaults (per-company override)
# Normalised at scoring time, so any positive numbers work.
ATS_WEIGHT_SKILLS=0.40
ATS_WEIGHT_EXPERIENCE=0.25
ATS_WEIGHT_EDUCATION=0.10
ATS_WEIGHT_RESPONSIBILITIES=0.15
ATS_WEIGHT_SEMANTIC=0.10

DATA_RETENTION_DAYS=730

# -------------------------------------------------------------------- seed data
# Used by `python -m app.db.seed`. Change before exposing any environment.
SEED_SUPER_ADMIN_EMAIL=admin@hirehq.test
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2024
SEED_DEMO_PASSWORD=Demo!2024Pass
